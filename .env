# Примеры переменных окружения для MariaDB
MARIADB_EXTERNAL_HOST=mariadb
MARIADB_EXTERNAL_PORT=3306
MARIADB_DATABASE=default_db
MARIADB_USER=default_user
# ВАЖНО!
# 1. Установите пароль для пользователя MARIADB_USER
MARIADB_PASSWORD=default_user_password
# 2. Установите пароль для пользователя root
MARIADB_ROOT_PASSWORD=default_root_password
# 3. Установите пароль для пользователя debezium
# Если оставить пустым, пользователь debezium не создается
MARIADB_DEBEZIUM_PASSWORD=default_debezium_password
# Опционально можем проверять в healthcheck.sh наличие таблицы, а в ней индекса.
# MARIADB_HEALTHCHECK_INDEX сверяется с именем индекса, у первичного ключа это PRIMARY
MARIADB_HEALTHCHECK_TABLE=some_table
MARIADB_HEALTHCHECK_INDEX=PRIMARY
