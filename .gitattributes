# Принудительно использовать LF для всех текстовых файлов
* text=auto eol=lf

# Явно указываем текстовые файлы
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.html text eol=lf
*.css text eol=lf
*.xml text eol=lf
*.toml text eol=lf
*.requirements text eol=lf

# Dockerfile и связанные файлы
Dockerfile* text eol=lf
*.dockerfile text eol=lf
docker-compose*.yml text eol=lf

# Конфигурационные файлы
.gitignore text eol=lf
.gitattributes text eol=lf
.env* text eol=lf
*.env text eol=lf

# Бинарные файлы (не изменяем окончания строк)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary 